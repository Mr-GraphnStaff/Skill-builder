{
  "name": "skill-builder",
  "displayName": "SkillJetty — Agent Skills Studio",
  "description": "Create, edit, version and publish portable Agent Skills with SkillJetty by DAF-TECH. Build it. Version it. Ship it.",
  "version": "0.11.4",
  "publisher": "DavidFarris",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mr-GraphnStaff/Skill-builder.git"
  },
  "homepage": "https://github.com/Mr-GraphnStaff/Skill-builder#readme",
  "bugs": {
    "url": "https://github.com/Mr-GraphnStaff/Skill-builder/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Education"
  ],
  "keywords": [
    "claude",
    "anthropic",
    "skills",
    "claude skills",
    "agent skills",
    "ai agents",
    "ai workflow",
    "prompt engineering",
    "skill builder",
    "skill packaging",
    "skill validation",
    "vscode ai",
    "agent development",
    "codex",
    "gemini",
    "copilot",
    "skilljetty"
  ],
  "activationEvents": [
    "workspaceContains:.skilljetty-prerelease/skills/*/SKILL.md"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "skillBuilder.openWorkbench",
        "title": "SkillJetty: Open Workbench",
        "icon": "$(tools)"
      }
    ],
    "configuration": {
      "title": "SkillJetty",
      "properties": {
        "skillBuilder.skillsDirectory": {
          "type": "string",
          "default": "skills",
          "description": "Relative subdirectory inside the isolated prerelease work folder. Absolute or escaping inherited values use the safe default."
        },
        "skillBuilder.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Optional work folder. Public pre-release work is isolated in a .skilljetty-prerelease child folder; stable data is not migrated."
        },
        "skillBuilder.distDirectory": {
          "type": "string",
          "default": "dist",
          "description": "Relative subdirectory inside the isolated prerelease work folder. Absolute or escaping inherited values use the safe default."
        },
        "skillBuilder.claudeCodeSkillsDirectory": {
          "type": "string",
          "default": "",
          "description": "Directory used by 'Sync to Claude Code'. Leave empty to use ~/.claude/skills."
        }
      }
    },
    "menus": {
      "view/title": [],
      "view/item/context": [],
      "commandPalette": []
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillBuilder",
          "title": "SkillJetty",
          "icon": "images/workbench.svg"
        }
      ]
    },
    "views": {
      "skillBuilder": [
        {
          "id": "skillBuilder.guidedLauncher",
          "name": "SkillJetty — Public pre-release",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test/*.test.cjs",
    "watch": "tsc -watch -p ./",
    "package": "npm run package:pre-release",
    "package:pre-release": "vsce package --pre-release --out dist/skill-builder-0.11.4.vsix",
    "ci:package": "node scripts/ci/release.cjs prepare",
    "ci:beta-package": "node scripts/ci/beta-release.cjs prepare",
    "import-skill": "node scripts/import-skill.mjs",
    "publish-skill": "node scripts/publish-skill.mjs",
    "ci:prerelease-package": "node scripts/ci/prerelease-release.cjs prepare"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "js-yaml": "^4.3.2",
    "skills-ref": "0.1.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.19.0",
    "@types/vscode": "1.90.0",
    "typescript": "^5.8.3",
    "@vscode/vsce": "3.9.2"
  },
  "galleryBanner": {
    "color": "#0b2727",
    "theme": "dark"
  },
  "overrides": {
    "@vscode/vsce": {
      "@azure/identity": "4.13.0"
    }
  }
}
