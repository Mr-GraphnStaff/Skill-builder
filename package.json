{
  "name": "skill-builder",
  "displayName": "SkillJetty — Agent Skills Studio",
  "description": "Create, edit, version and publish portable Agent Skills with SkillJetty by DAF-TECH. Build it. Version it. Ship it.",
  "version": "0.15.2",
  "publisher": "DavidFarris",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mr-GraphnStaff/Skill-builder.git"
  },
  "homepage": "https://github.com/Mr-GraphnStaff/Skill-builder#readme",
  "bugs": {
    "url": "https://github.com/Mr-GraphnStaff/Skill-builder/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI"
  ],
  "keywords": [
    "claude",
    "anthropic",
    "skills",
    "claude skills",
    "agent skills",
    "ai agents",
    "ai workflow",
    "prompt engineering",
    "skill builder",
    "skill packaging",
    "skill validation",
    "vscode ai",
    "agent development",
    "codex",
    "gemini",
    "copilot",
    "skilljetty"
  ],
  "activationEvents": [
    "workspaceContains:.skilljetty-prerelease/skills/*/SKILL.md"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "skillBuilder.openWorkbench",
        "title": "SkillJetty: Open Workbench",
        "icon": "$(tools)"
      },
      {
        "command": "skillBuilder.showPerformanceLog",
        "title": "SkillJetty (Pre-release): Show Performance Log"
      },
      {
        "command": "skillBuilder.openSettings",
        "title": "SkillJetty: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "skillBuilder.connectGitHub",
        "title": "SkillJetty: Connect GitHub Account"
      },
      {
        "command": "skillBuilder.verifyRepository",
        "title": "SkillJetty: Verify Skills Repository"
      },
      {
        "command": "skillBuilder.pullRepository",
        "title": "SkillJetty: Pull Skills Repository"
      },
      {
        "command": "skillBuilder.openRepositorySkill",
        "title": "SkillJetty: Open Skill from Repository"
      },
      {
        "command": "skillBuilder.createRepository",
        "title": "SkillJetty: Create GitHub Repository"
      },
      {
        "command": "skillBuilder.createWorkbench",
        "title": "SkillJetty: Create Workbench"
      },
      {
        "command": "skillBuilder.openWorkbenchFolder",
        "title": "SkillJetty: Open Existing Workbench"
      }
    ],
    "configuration": {
      "title": "SkillJetty",
      "properties": {
        "skillBuilder.skillsDirectory": {
          "type": "string",
          "default": "skills",
          "order": 100,
          "description": "Advanced legacy integration: discovery directory, confined to the preview work folder. This does not move guided drafts, which use the work folder's skills directory."
        },
        "skillBuilder.projectRoot": {
          "type": "string",
          "default": "",
          "order": 10,
          "scope": "window",
          "description": "Optional existing SkillJetty workbench location. Must contain its setup record; arbitrary opened folders are never adopted. Use Create Workbench or Open Existing Workbench for setup. Preview data stays in .skilljetty-prerelease. Changing this does not move files; save and reopen."
        },
        "skillBuilder.prerelease.repositoryUrl": {
          "type": "string",
          "default": "",
          "order": 20,
          "scope": "window",
          "description": "Sharing repository address for this pre-release, for example https://github.com/your-org/skills.git. Use Workspace settings for this project. An explicitly empty value disconnects sharing; Reset preserves an existing saved connection. The default branch is detected when you verify or submit. Use VS Code Accounts or SkillJetty: Connect GitHub Account to sign in. No credentials belong here."
        },
        "skillBuilder.prerelease.localRepositoryPath": {
          "type": "string",
          "default": "",
          "order": 30,
          "scope": "window",
          "description": "Optional absolute path to a local Git repository inside this workbench’s repositories/ folder. Unset uses repositories/skills; an explicit blank disables local reuse. Pull clones or updates it only when you run that command. Outside folders and linked paths are blocked. Existing repositories are never moved automatically."
        },
        "skillBuilder.distDirectory": {
          "type": "string",
          "default": "dist",
          "order": 110,
          "description": "Advanced legacy integration: ZIP-export directory, confined to the preview work folder. Guided .skill packages instead use releases/<skill>/<version>; this setting does not relocate them."
        },
        "skillBuilder.claudeCodeSkillsDirectory": {
          "type": "string",
          "default": "",
          "order": 120,
          "description": "Retained legacy setting for compatibility. External-folder installation is unavailable in this pre-release: all SkillJetty work writes must stay inside the selected workbench."
        }
      }
    },
    "menus": {
      "view/title": [],
      "view/item/context": [],
      "commandPalette": []
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillBuilder",
          "title": "SkillJetty",
          "icon": "images/workbench.svg"
        }
      ]
    },
    "views": {
      "skillBuilder": [
        {
          "id": "skillBuilder.guidedLauncher",
          "name": "SkillJetty — Public pre-release",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test --test-concurrency=4 test/*.test.cjs",
    "watch": "tsc -watch -p ./",
    "package": "npm run package:pre-release",
    "package:pre-release": "vsce package --pre-release --out dist/skill-builder-0.15.2.vsix",
    "ci:package": "node scripts/ci/release.cjs prepare",
    "ci:beta-package": "node scripts/ci/beta-release.cjs prepare",
    "import-skill": "node scripts/import-skill.mjs",
    "publish-skill": "node scripts/publish-skill.mjs",
    "ci:prerelease-package": "node scripts/ci/prerelease-release.cjs prepare"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "js-yaml": "^4.3.2",
    "skills-ref": "0.1.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.19.0",
    "@types/vscode": "1.90.0",
    "typescript": "^5.8.3",
    "@vscode/vsce": "3.9.2"
  },
  "galleryBanner": {
    "color": "#0b2727",
    "theme": "dark"
  },
  "overrides": {
    "@vscode/vsce": {
      "@azure/identity": "4.13.0"
    }
  }
}
